{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://augmented-hub.local/schemas/kfk-trust-manifest.schema.json",
  "title": "KFK Trust Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current_kfk_version",
    "versions",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "current_kfk_version": {
      "type": "string",
      "pattern": "^kfk-[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "status",
          "validated_trust",
          "validated_at",
          "evidence_feature_set"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^kfk-[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "supported",
              "deprecated",
              "superseded",
              "revoked"
            ]
          },
          "validated_trust": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "validated_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_feature_set": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "supersedes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^kfk-[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          },
          "review_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_lag_decay",
        "age_decay_per_30_days",
        "minimum_non_revoked_multiplier",
        "unknown_version_multiplier",
        "revoked_version_multiplier"
      ],
      "properties": {
        "version_lag_decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "age_decay_per_30_days": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_non_revoked_multiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unknown_version_multiplier": {
          "type": "number",
          "const": 0
        },
        "revoked_version_multiplier": {
          "type": "number",
          "const": 0
        }
      }
    }
  }
}
