{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://augmented-hub.local/schemas/eco_karma_window.schema.json",
  "title": "Eco Karma Window",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window",
    "concentration",
    "reference_mass",
    "flow",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_utc",
        "end_utc"
      ],
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "concentration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_mass_per_m3",
        "out_mass_per_m3",
        "parameter"
      ],
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "in_mass_per_m3": {
          "type": "number",
          "minimum": 0
        },
        "out_mass_per_m3": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "reference_mass": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "flow": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "flow_m3_per_s"
          ],
          "properties": {
            "mode": {
              "const": "constant"
            },
            "flow_m3_per_s": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "coverage",
            "segments"
          ],
          "properties": {
            "mode": {
              "const": "piecewise_constant"
            },
            "coverage": {
              "type": "string",
              "enum": [
                "required_full_window",
                "partial_window_allowed"
              ]
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "start_utc",
                  "end_utc",
                  "flow_m3_per_s"
                ],
                "properties": {
                  "start_utc": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end_utc": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "flow_m3_per_s": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "sha256"
      ],
      "properties": {
        "artifact_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
